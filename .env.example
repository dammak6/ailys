# =============================================================================
# AÏLYS SUPABASE PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Public Supabase Project URL (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Safe for client-side queries, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Only Supabase Service Role Key (NEVER expose to browser, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret for server-side token validation
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
